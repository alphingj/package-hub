# Template only — install.sh writes the real entry with an absolute Exec
# path into ~/.local/share/applications/.
[Desktop Entry]
Name=package-hub
GenericName=App Store
Comment=Install, remove, and update software without the terminal
Exec=package-hub
Icon=package-hub
Terminal=false
Type=Application
Categories=System;PackageManager;GTK;
StartupNotify=true
Keywords=apt;dnf;pacman;zypper;flatpak;install;software;store;
